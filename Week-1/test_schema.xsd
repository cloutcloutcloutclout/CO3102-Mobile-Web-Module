<?xml version="1.0"?>
<xsd:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

 <xsd:complexType name ="article">
  <xsd:sequence>
   <xsd:element name="author" type="xsd:string" maxOccurs="unbounded"/>
   <xsd:element name="title" type="xsd:string"/>
   <xsd:element name="year" type="xsd:integer"/>
   <xsd:element name="publisher" type="xsd:string"/>
   <xsd:element name="startingpage" type="xsd:integer"/>
   <xsd:element name="endingpage" type="xsd:integer"/>
   <xsd:element name="journal" type="xsd:string"/>
  </xsd:sequence>
 </xsd:complexType>

 <xsd:complexType name="website">
    <xsd:sequence>
      <xsd:element name="url" type="xsd:string"/>
      <xsd:element name="date" type="xsd:date"/>
      <xsd:element name="author" type="xsd:string"  maxOccurs="unbounded"/>
      <xsd:element name="title" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>

 <xsd:complexType name ="unpublished">
  <xsd:sequence>
   <xsd:element name="author" type="xsd:string" maxOccurs="unbounded"/>
   <xsd:element name="title" type="xsd:string"/>
   <xsd:element name="year" type="xsd:integer"/>
  </xsd:sequence>
 </xsd:complexType>

 <xsd:complexType name ="book">
  <xsd:sequence>
   <xsd:element name="author" type="xsd:string" maxOccurs="unbounded"/>
   <xsd:element name="title" type="xsd:string"/>
   <xsd:element name="year" type="xsd:integer"/>
   <xsd:element name="publisher" type="xsd:string"/>
  </xsd:sequence>
 </xsd:complexType>

  <xsd:complexType name ="website">
  <xsd:sequence>
   <xsd:element name="author" type="xsd:string" maxOccurs="unbounded"/>
   <xsd:element name="url" type="xsd:string"/>
   <xsd:element name="title" type="xsd:string"/>
   <xsd:element name="date" type="xsd:date"/>
  </xsd:sequence>
 </xsd:complexType>

  <xsd:complexType name="bibilographic">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
		<xsd:element name="book" type="book"/>
		<xsd:element name="article" type="article"/>
		<xsd:element name="website" type="website"/>
		<xsd:element name="unpublished" type="unpublished"/>
      </xsd:choice>
  </xsd:complexType>

  <xsd:element name="bibilographic" type="bibilographic"/>

</xsd:schema>
